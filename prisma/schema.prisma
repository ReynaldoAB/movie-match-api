generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// NUEVO: Enum con géneros válidos
enum Genre {
  ACTION
  COMEDY
  DRAMA
  HORROR
  SCIFI
  THRILLER
}

model Movie {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  rating    Float
  poster    String?
  genre     Genre // NUEVO: Campo de género usando el enum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]
}

